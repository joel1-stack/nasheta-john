rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow anyone to read articles (needed for blog posts to load)
    match /articles/{article} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Allow authenticated users to manage affiliate links
    match /affiliateLinks/{link} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Click tracking - anyone can write (for API route), only auth can read
    match /clicks/{click} {
      allow read: if request.auth != null;
      allow create: if true;
    }
    // Newsletter subscribers - anyone can subscribe, only auth can list
    match /subscribers/{subscriber} {
      allow create: if true;
      allow read: if request.auth != null;
    }
  }
}
