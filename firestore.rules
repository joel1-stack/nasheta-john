rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Articles: public read, only authenticated admin can write
    match /articles/{article} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Affiliate links: public read, only authenticated admin can write
    match /affiliateLinks/{link} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Operators: public read (for future frontend), auth write
    match /operators/{operator} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Categories: public read, auth write
    match /categories/{category} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Site settings: public read, auth write
    match /settings/{setting} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Click tracking - anyone can write (for API route), only auth can read
    match /clicks/{click} {
      allow read: if request.auth != null;
      allow create: if true;
    }
    // Newsletter subscribers - anyone can subscribe, only auth can list
    match /subscribers/{subscriber} {
      allow create: if true;
      allow read: if request.auth != null;
      allow delete: if request.auth != null;
    }
    // Contact messages - public create, auth read/write (dashboard inbox)
    match /contactMessages/{message} {
      allow create: if true;
      allow read: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }
  }
}
